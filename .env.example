# Salin file ini menjadi ".env", lalu isi nilainya.
# File ".env" jangan pernah diunggah ke GitHub.

# Kata sandi untuk masuk ke dashboard admin (/admin). Pilih yang panjang dan sulit ditebak.
ADMIN_PASSWORD=ganti-dengan-kata-sandi-kuat

# Teks acak panjang untuk mengamankan sesi login (isi bebas, minimal 32 karakter).
SESSION_SECRET=ganti-dengan-teks-acak-yang-panjang-sekali

# Port server (boleh dibiarkan 3000).
PORT=3000

# Aktifkan hanya saat website sudah online dengan HTTPS (bukan saat dijalankan di komputer sendiri).
# NODE_ENV=production

# Lokasi penyimpanan data dan gambar (opsional). Berguna jika hosting menyediakan disk permanen.
# DATA_DIR=/var/data
